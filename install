#!/bin/bash
set -e
umask 077
PATH="$PATH:$HOME/.nix-profile/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/local/bin"
export PATH
source_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
install_dir="$HOME/.vim-anywhere"
config="${XDG_CONFIG_HOME:-$HOME/.config}/vim-anywhere/config"
selected=
if [ -f "$config" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in editor=*) selected=${line#editor=} ;; esac
  done < "$config"
fi
case "$OSTYPE" in
  darwin*) selected=${VIM_ANYWHERE_EDITOR:-${selected:-neovide}} ;;
  linux*) selected=${VIM_ANYWHERE_EDITOR:-${selected:-gvim}} ;;
  *) echo "vim-anywhere: unsupported platform: $OSTYPE" >&2; exit 1 ;;
esac
require() { command -v "$1" >/dev/null 2>&1 || { echo "vim-anywhere: requires $1" >&2; exit 1; }; }
require git
case "$selected" in
  */*) [ -f "$selected" ] && [ -x "$selected" ] || { echo "vim-anywhere: editor not executable: $selected" >&2; exit 1; } ;;
  *) require "$selected" ;;
esac
case "${selected##*/}" in neovide) require nvim ;; esac
case "$OSTYPE" in
  linux*) require xclip; if ! command -v gconftool >/dev/null && ! command -v gsettings >/dev/null; then echo 'vim-anywhere: requires gsettings or gconftool' >&2; exit 1; fi ;;
esac
[ -d "$source_dir/.git" ] || { echo 'vim-anywhere: run install from a local Git checkout of this fork' >&2; exit 1; }
if [ "$source_dir" = "$install_dir" ]; then echo 'vim-anywhere: already installed; use update instead' >&2; exit 1; fi
stage=$(mktemp -d "$HOME/.vim-anywhere-stage.XXXXXXXX")
installed=false
finished=false
cleanup() {
  if [ "$finished" != true ] && [ "$installed" = true ]; then
    rm -rf "$install_dir"
    if [ -n "${backup:-}" ]; then mv "$backup" "$install_dir"; fi
    if [ "${service_changed:-false}" = true ]; then
      rm -rf "$service"
      if [ -n "${service_backup:-}" ]; then mv "$service_backup" "$service"; fi
    fi
  fi
  [ -z "$stage" ] || rm -rf "$stage"
}
trap cleanup EXIT
git clone --quiet "$source_dir" "$stage/repo"
# Include the current checkout, including intentional uncommitted changes.
for path in bin script VimAnywhere.workflow install update uninstall README.md FAQ.md CONTRIBUTING.md; do
  rm -rf "$stage/repo/$path"
  cp -R "$source_dir/$path" "$stage/repo/$path"
done
if [ -e "$install_dir" ] || [ -L "$install_dir" ]; then
  backup=$(mktemp -d "$HOME/.vim-anywhere-backup.XXXXXXXX")
  rmdir "$backup"
  mv "$install_dir" "$backup"
  echo "Previous installation preserved at $backup"
fi
if ! mv "$stage/repo" "$install_dir"; then
  [ -z "${backup:-}" ] || mv "$backup" "$install_dir"
  exit 1
fi
installed=true
case "$OSTYPE" in
  darwin*)
    mkdir -p "$HOME/Library/Services"
    service="$HOME/Library/Services/VimAnywhere.workflow"
    if [ -e "$service" ]; then
      service_backup=$(mktemp -d "$HOME/Library/Services/.VimAnywhere-backup.XXXXXXXX")
      rmdir "$service_backup"
      mv "$service" "$service_backup"
      echo "Previous workflow preserved at $service_backup"
    fi
    service_changed=true
    cp -R "$install_dir/VimAnywhere.workflow" "$service"
    echo 'Set the VimAnywhere shortcut in System Settings > Keyboard > Keyboard Shortcuts > Services.' ;;
  linux*)
    name=vim-anywhere; binding='<CTRL><ALT>v'; action="$install_dir/bin/run"
    if command -v gconftool >/dev/null; then
      kbd_path=/desktop/gnome/keybindings/vim-anywhere
      gconftool -t str --set "$kbd_path/name" "$name"
      gconftool -t str --set "$kbd_path/binding" "$binding"
      gconftool -t str --set "$kbd_path/action" "$action"
    else
      media_keys=org.gnome.settings-daemon.plugins.media-keys
      custom_kbd=org.gnome.settings-daemon.plugins.media-keys.custom-keybinding
      kbd_path=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/vim-anywhere/
      bindings=$(gsettings get "$media_keys" custom-keybindings)
      case "$bindings" in *"'$kbd_path'"*) ;; *) bindings=$(printf '%s' "$bindings" | sed -e "s>']>','$kbd_path']>" -e "s>@as \[\]>['$kbd_path']>"); gsettings set "$media_keys" custom-keybindings "$bindings" ;; esac
      gsettings set "$custom_kbd:$kbd_path" name "$name"
      gsettings set "$custom_kbd:$kbd_path" binding "$binding"
      gsettings set "$custom_kbd:$kbd_path" command "$action"
    fi ;;
esac
finished=true
echo 'vim-anywhere has been successfully installed!'
