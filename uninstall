#!/bin/bash
set -e
install_dir="$HOME/.nvim-anywhere"
if [ -e "$install_dir" ]; then
  if [ ! -f "$install_dir/bin/run" ] || [ ! -f "$install_dir/uninstall" ]; then
    echo "nvim-anywhere: refusing to remove unrecognized directory $install_dir" >&2; exit 1
  fi
  backup=$(mktemp -d "$HOME/.nvim-anywhere-uninstalled.XXXXXXXX")
  rmdir "$backup"
  mv "$install_dir" "$backup"
  echo "Installation preserved at $backup"
fi
case "$OSTYPE" in
  darwin*)
    service="$HOME/Library/Services/NvimAnywhere.workflow"
    if [ -f "$service/Contents/document.wflow" ] && grep -q '.nvim-anywhere/bin/run' "$service/Contents/document.wflow"; then rm -rf "$service"; fi ;;
  linux*) echo 'Remove the nvim-anywhere shortcut from your desktop or compositor configuration.' ;;
esac
echo 'nvim-anywhere has been uninstalled; configuration and editing history were preserved.'
