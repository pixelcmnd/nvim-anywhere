#!/bin/bash
set -e
umask 077
PATH="$PATH:$HOME/.nix-profile/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/local/bin"
export PATH
source_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
install_dir="$HOME/.nvim-anywhere"
config="${XDG_CONFIG_HOME:-$HOME/.config}/nvim-anywhere/config"
legacy_config="${XDG_CONFIG_HOME:-$HOME/.config}/vim-anywhere/config"
if [ ! -f "$config" ] && [ -f "$legacy_config" ]; then config=$legacy_config; fi
selected=
if [ -f "$config" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in editor=*) selected=${line#editor=} ;; esac
  done < "$config"
fi
case "$OSTYPE" in
  darwin*) selected=${NVIM_ANYWHERE_EDITOR:-${VIM_ANYWHERE_EDITOR:-${selected:-neovide}}} ;;
  linux*) selected=${NVIM_ANYWHERE_EDITOR:-${VIM_ANYWHERE_EDITOR:-${selected:-neovide}}} ;;
  *) echo "nvim-anywhere: unsupported platform: $OSTYPE" >&2; exit 1 ;;
esac
require() { command -v "$1" >/dev/null 2>&1 || { echo "nvim-anywhere: requires $1" >&2; exit 1; }; }
require git
case "$selected" in
  */*) [ -f "$selected" ] && [ -x "$selected" ] || { echo "nvim-anywhere: editor not executable: $selected" >&2; exit 1; } ;;
  *) require "$selected" ;;
esac
case "${selected##*/}" in neovide) require nvim ;; esac
case "$OSTYPE" in
  linux*)
    case "${selected##*/}" in gvim|mvim) echo 'nvim-anywhere: mvim and gvim are not supported on Linux; use a Wayland editor' >&2; exit 1 ;; esac
    require wl-copy ;;
esac
[ -d "$source_dir/.git" ] || { echo 'nvim-anywhere: run install from a local Git checkout of this fork' >&2; exit 1; }
if [ "$source_dir" = "$install_dir" ]; then echo 'nvim-anywhere: already installed; use update instead' >&2; exit 1; fi
stage=$(mktemp -d "$HOME/.nvim-anywhere-stage.XXXXXXXX")
installed=false
finished=false
cleanup() {
  if [ "$finished" != true ] && [ "$installed" = true ]; then
    rm -rf "$install_dir"
    if [ -n "${backup:-}" ]; then mv "$backup" "$install_dir"; fi
    if [ "${service_changed:-false}" = true ]; then
      rm -rf "$service"
      if [ -n "${service_backup:-}" ]; then mv "$service_backup" "$service"; fi
    fi
  fi
  [ -z "$stage" ] || rm -rf "$stage"
}
trap cleanup EXIT
git clone --quiet "$source_dir" "$stage/repo"
# Include the current checkout, including intentional uncommitted changes.
for path in bin script NvimAnywhere.workflow install update uninstall README.md FAQ.md LICENSE; do
  rm -rf "$stage/repo/$path"
  cp -R "$source_dir/$path" "$stage/repo/$path"
done
if [ -e "$install_dir" ] || [ -L "$install_dir" ]; then
  backup=$(mktemp -d "$HOME/.nvim-anywhere-backup.XXXXXXXX")
  rmdir "$backup"
  mv "$install_dir" "$backup"
  echo "Previous installation preserved at $backup"
fi
if ! mv "$stage/repo" "$install_dir"; then
  [ -z "${backup:-}" ] || mv "$backup" "$install_dir"
  exit 1
fi
installed=true
case "$OSTYPE" in
  darwin*)
    mkdir -p "$HOME/Library/Services"
    service="$HOME/Library/Services/NvimAnywhere.workflow"
    if [ -e "$service" ]; then
      service_backup=$(mktemp -d "$HOME/Library/Services/.NvimAnywhere-backup.XXXXXXXX")
      rmdir "$service_backup"
      mv "$service" "$service_backup"
      echo "Previous workflow preserved at $service_backup"
    fi
    service_changed=true
    cp -R "$install_dir/NvimAnywhere.workflow" "$service"
    if [ -e "$HOME/Library/Services/VimAnywhere.workflow" ]; then
      echo 'The old VimAnywhere service is still installed; disable its shortcut before assigning it to NvimAnywhere.'
    fi
    echo 'Set Control+Option+Command+I for NvimAnywhere in System Settings > Keyboard > Keyboard Shortcuts > Services.' ;;
  linux*)
    echo 'Configure Control+Alt+Super+I in your desktop or compositor; see the README.' ;;
esac
finished=true
echo 'nvim-anywhere has been successfully installed!'
